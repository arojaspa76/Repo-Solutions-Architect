# ============================================================
# Variables de Entorno — Sesión 7
# Copiar a .env y completar con credenciales reales
# NUNCA commitear el archivo .env al repositorio
# ============================================================

# --- Configuración General ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000

# --- Ollama (LLM local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# --- Agente LLM ---
AGENT_MAX_STEPS=10               # Máximo de pasos ReAct por ejecución
AGENT_TIMEOUT=60                 # Timeout total del agente (segundos)
AGENT_TEMPERATURE=0.1            # Baja temperatura para agentes (más predecible)
ENABLE_AGENT_MEMORY=true         # Memoria de conversación por sesión

# --- Cache ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
ENABLE_CACHE=true

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Azure OpenAI (opcional — para pruebas en nube) ---
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Google Cloud (opcional) ---
GOOGLE_CLOUD_PROJECT=your-project-id
GCP_REGION=us-central1

# --- AWS (opcional) ---
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_DEFAULT_REGION=us-east-1

# --- Monitoreo ---
PROMETHEUS_ENABLED=true

# --- Pruebas de Carga ---
LOAD_TEST_TARGET_URL=http://localhost:8000
LOAD_TEST_DURATION=300
LOAD_TEST_USERS=50
